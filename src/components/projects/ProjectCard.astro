---
interface Props {
  title: string;
  description: string;
  features: string[];
  technologies: string[];
  status: 'completed' | 'in-development' | 'live';
  projectIndex: number;
}

const { title, description, features, technologies, status, projectIndex } = Astro.props;

const statusLabels = {
  completed: 'Completado',
  'in-development': 'En Desarrollo',
  live: 'En Producción'
};

const statusColors = {
  completed: '#00FF66',
  'in-development': '#38F93E',
  live: '#00C853'
};
---

<div class="project-card glass fade-in-up">
  <div class="project-header">
    <h3>{title}</h3>
    <span class="project-status" style="background: {statusColors[status]}">{statusLabels[status]}</span>
  </div>
  
  <p class="project-description">{description}</p>
  
  <div class="project-features">
    <h4>Características Destacadas</h4>
    <ul>
      {features.map((feature) => (
        <li>{feature}</li>
      ))}
    </ul>
  </div>

  <div class="project-technologies">
    <h4>Tecnologías</h4>
    <div class="tech-tags">
      {technologies.map((tech) => (
        <span class="tech-tag">{tech}</span>
      ))}
    </div>
  </div>

  <button class="btn-view-more" data-project-index={projectIndex}>Ver más</button>
</div>

<script>
  document.addEventListener('click', (e) => {
    if (e.target && e.target.classList.contains('btn-view-more')) {
      const index = parseInt(e.target.getAttribute('data-project-index') || '0');
      window.openProjectModal(index);
    }
  });
</script>

<style>
  .project-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  .project-header h3 {
    font-size: 1.3rem;
    margin: 0;
    color: var(--monster-green);
    flex: 1;
  }

  .project-status {
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--bg-deep);
    white-space: nowrap;
  }

  .project-description {
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .project-features {
    margin-bottom: 1.5rem;
  }

  .project-features h4 {
    font-size: 0.95rem;
    color: var(--monster-green);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .project-features ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-features li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .project-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--monster-green);
    font-weight: 700;
  }

  .project-technologies {
    margin-bottom: 1.5rem;
  }

  .project-technologies h4 {
    font-size: 0.95rem;
    color: var(--monster-green);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    background: rgba(56, 249, 62, 0.1);
    border: 1px solid var(--glass-border);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .btn-view-more {
    margin-top: auto;
    align-self: flex-start;
    background: var(--gradient-primary);
    color: var(--bg-deep);
    padding: 0.75rem 2rem;
    border: none;
    border-radius: 50px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-view-more:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px var(--monster-glow-hover);
  }

  @media (max-width: 768px) {
    .project-header {
      flex-direction: column;
    }

    .project-header h3 {
      font-size: 1.15rem;
    }

    .project-description,
    .project-features li {
      font-size: 0.9rem;
    }
  }
</style>
