---
import L10nText from '../L10nText.astro';
import type { L10n } from '../../i18n/types';

interface Props {
  title: L10n;
  description: L10n;
  features: L10n[];
  technologies: string[];
  status: 'completed' | 'in-development' | 'live';
  projectIndex: number;
}

const { title, description, features, technologies, status, projectIndex } = Astro.props;

// Status enum reconciliation: data uses kebab-case 'in-development' but the i18n
// key is camelCase 'inDevelopment'. Bridge the mismatch so the badge resolves to
// the correct localized label (projects.status.completed / live / inDevelopment).
const statusKey = status === 'in-development' ? 'inDevelopment' : status;

const statusColors: Record<Props['status'], string> = {
  completed: '#00FF66',
  'in-development': '#38F93E',
  live: '#00C853'
};
---

<div class="project-card glass fade-in-up">
  <div class="project-header">
    <h3><L10nText text={title} /></h3>
    <span class="project-status" style={`background: ${statusColors[status]}`} data-i18n={`projects.status.${statusKey}`}>{statusKey}</span>
  </div>

  <p class="project-description"><L10nText text={description} /></p>

  <div class="project-features">
    <h4 data-i18n="projects.features">Key Features</h4>
    <ul>
      {features.map((feature) => (
        <li><L10nText text={feature} /></li>
      ))}
    </ul>
  </div>

  <div class="project-technologies">
    <h4 data-i18n="projects.technologies">Technologies</h4>
    <div class="tech-tags">
      {technologies.map((tech) => (
        <span class="tech-tag">{tech}</span>
      ))}
    </div>
  </div>

  <button class="btn-view-more" data-project-index={projectIndex} data-i18n="projects.viewMore">View More</button>
</div>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target && target.classList.contains('btn-view-more')) {
      const index = parseInt(target.getAttribute('data-project-index') || '0');
      window.openProjectModal(index);
    }
  });
</script>

<style>
  .project-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  .project-header h3 {
    font-size: 1.3rem;
    margin: 0;
    color: var(--monster-green);
    flex: 1;
  }

  .project-status {
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--bg-deep);
    white-space: nowrap;
  }

  .project-description {
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .project-features {
    margin-bottom: 1.5rem;
  }

  .project-features h4 {
    font-size: 0.95rem;
    color: var(--monster-green);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .project-features ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-features li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .project-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--monster-green);
    font-weight: 700;
  }

  .project-technologies {
    margin-bottom: 1.5rem;
  }

  .project-technologies h4 {
    font-size: 0.95rem;
    color: var(--monster-green);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    background: rgba(56, 249, 62, 0.1);
    border: 1px solid var(--glass-border);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .btn-view-more {
    margin-top: auto;
    align-self: flex-start;
    background: var(--gradient-primary);
    color: var(--bg-deep);
    padding: 0.75rem 2rem;
    border: none;
    border-radius: 50px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-view-more:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px var(--monster-glow-hover);
  }

  @media (max-width: 768px) {
    .project-header {
      flex-direction: column;
    }

    .project-header h3 {
      font-size: 1.15rem;
    }

    .project-description,
    .project-features li {
      font-size: 0.9rem;
    }
  }
</style>
