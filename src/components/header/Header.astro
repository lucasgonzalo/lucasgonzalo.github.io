---
---

<header>
  <div class="container">
    <h1 class="logo-text">Lucas GAM</h1>
    <nav>
      <ul>
        <li><a href="#about">About</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#contact">Contact</a></li>
        <li>
          <button id="translateToggle" class="btn-translate-icon">
            <i class="fas fa-globe"></i>
          </button>
          <div id="googleTranslateDropdown" class="translate-dropdown hidden">
            <div id="google_translate_element"></div>
            <button class="btn-close-translate">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1rem 2rem;
    background: rgba(13, 13, 13, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--glass-border);
    transition: all 0.3s ease;
  }

  header .container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  header h1 {
    font-size: 1.5rem;
    margin: 0;
  }

  .logo-text {
    font-family: 'Orbitron', sans-serif;
    font-weight: 700;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    position: relative;
    display: inline-block;
    animation: breathe 4s ease-in-out infinite;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes breathe {
    0%, 100% {
      text-shadow:
        0 0 10px var(--monster-glow),
        0 0 20px rgba(56, 249, 62, 0.2);
    }
    50% {
      text-shadow:
        0 0 15px var(--monster-glow),
        0 0 30px rgba(56, 249, 62, 0.15);
    }
  }

  .logo-text:hover {
    transform: scale(1.05);
    text-shadow:
      0 0 20px var(--monster-glow-hover),
      0 0 40px rgba(56, 249, 62, 0.25);
    cursor: default;
  }

  @media (max-width: 768px) {
    .logo-text {
      font-size: 2rem;
    }
  }

  nav ul {
    display: flex;
    list-style: none;
    gap: 2rem;
    margin: 0;
    align-items: center;
  }

  nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
    transition: color 0.3s ease;
    position: relative;
  }

  nav a:hover {
    color: var(--monster-green);
  }

  nav a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--monster-green);
    transition: width 0.3s ease;
  }

  nav a:hover::after {
    width: 100%;
  }

  .btn-translate-icon {
    background: transparent;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-translate-icon i {
    font-size: 1.3rem;
    color: var(--monster-green);
    transition: transform 0.5s ease;
  }

  .btn-translate-icon:hover i {
    transform: rotate(360deg);
    filter: drop-shadow(0 0 10px var(--monster-green));
  }

  .translate-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.5rem;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 1rem;
    min-width: 200px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    z-index: 1001;
  }

  .translate-dropdown.hidden {
    display: none;
  }

  .btn-close-translate {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
    font-size: 0.9rem;
    transition: all 0.3s ease;
  }

  .btn-close-translate:hover {
    color: var(--monster-green);
  }

  #google_translate_element select {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    color: var(--text-primary);
    padding: 0.5rem;
    border-radius: 8px;
    width: 100%;
    margin-top: 0.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  #google_translate_element select:hover {
    border-color: var(--monster-green);
    box-shadow: 0 0 15px var(--monster-glow);
  }

  @media (max-width: 992px) {
    nav ul {
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    header {
      padding: 1rem;
    }

    header .container {
      flex-direction: column;
      gap: 1rem;
    }

    nav ul {
      gap: 1rem;
      font-size: 0.9rem;
    }
  }
</style>

<script>
  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    const link = anchor as HTMLAnchorElement;
    link.addEventListener('click', (e) => {
      const target = document.querySelector(link.getAttribute('href') || '');
      if (target) {
        e.preventDefault();
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });

  // Google Translate dropdown toggle
  const translateToggle = document.getElementById('translateToggle');
  const translateDropdown = document.getElementById('googleTranslateDropdown');
  const btnCloseTranslate = document.querySelector('.btn-close-translate');

  if (translateToggle && translateDropdown && btnCloseTranslate) {
    translateToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      translateDropdown.classList.toggle('hidden');
    });

    btnCloseTranslate.addEventListener('click', (e) => {
      e.stopPropagation();
      translateDropdown.classList.add('hidden');
    });
  }

  // Close translate dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (translateDropdown && e.target) {
      const target = e.target as Element;
      if (!target.closest('#translateToggle') && !target.closest('#googleTranslateDropdown')) {
        translateDropdown.classList.add('hidden');
      }
    }
  });
</script>
