---
import LanguageSwitcher from '../LanguageSwitcher.astro';
---

<header>
  <div class="container">
    <h1 class="logo-text">Lucas GAM</h1>
    <nav>
      <ul>
        <li><a href="#about" data-i18n="nav.about">About</a></li>
        <li><a href="#skills" data-i18n="nav.skills">Skills</a></li>
        <li><a href="#experience" data-i18n="nav.experience">Experience</a></li>
        <li><a href="#projects" data-i18n="nav.projects">Projects</a></li>
        <li><a href="#contact" data-i18n="nav.contact">Contact</a></li>
        <li>
          <LanguageSwitcher />
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Update nav items on language change
  window.addEventListener('language-changed', () => {
    const t = window.t || ((key) => key);
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key) {
        el.textContent = t(key);
      }
    });
  });
</script>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1rem 2rem;
    background: rgba(13, 13, 13, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--glass-border);
    transition: all 0.3s ease;
  }

  header .container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  header h1 {
    font-size: 1.5rem;
    margin: 0;
  }

  .logo-text {
    font-family: 'Orbitron', sans-serif;
    font-weight: 700;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    position: relative;
    display: inline-block;
    animation: breathe 4s ease-in-out infinite;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes breathe {
    0%, 100% {
      text-shadow:
        0 0 10px var(--monster-glow),
        0 0 20px rgba(56, 249, 62, 0.2);
    }
    50% {
      text-shadow:
        0 0 15px var(--monster-glow),
        0 0 30px rgba(56, 249, 62, 0.15);
    }
  }

  .logo-text:hover {
    transform: scale(1.05);
    text-shadow:
      0 0 20px var(--monster-glow-hover),
      0 0 40px rgba(56, 249, 62, 0.25);
    cursor: default;
  }

  @media (max-width: 768px) {
    .logo-text {
      font-size: 2rem;
    }
  }

  nav ul {
    display: flex;
    list-style: none;
    gap: 2rem;
    margin: 0;
    align-items: center;
  }

  nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
    transition: color 0.3s ease;
    position: relative;
  }

  nav a:hover {
    color: var(--monster-green);
  }

  nav a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--monster-green);
    transition: width 0.3s ease;
  }

  nav a:hover::after {
    width: 100%;
  }

  @media (max-width: 992px) {
    nav ul {
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    header {
      padding: 1rem;
    }

    header .container {
      flex-direction: column;
      gap: 1rem;
    }

    nav ul {
      gap: 1rem;
      font-size: 0.9rem;
    }
  }
</style>

