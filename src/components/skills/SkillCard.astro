---
interface Props {
  icon: string;
  name: string;
  description: string;
}

const { icon, name, description } = Astro.props;
---

<div class="skill-card glass">
  <i class={`skill-icon ${icon}`}></i>
  <span>{name} <i class="fas fa-chevron-down expand-icon"></i></span>
  <div class="skill-description">{description}</div>
</div>

<style>
  .skill-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    min-height: 180px;
    transition: all 0.3s ease;
  }

  .skill-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: var(--monster-green);
    transition: all 0.3s ease;
  }

  .skill-card:hover {
    transform: translateY(-8px);
  }

  .skill-card:hover .skill-icon {
    transform: scale(1.2);
    filter: drop-shadow(0 0 10px var(--monster-green));
  }

  .skill-card span {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .expand-icon {
    font-size: 0.5rem;
    transition: transform 0.3s ease;
    opacity: 0.6;
    color: var(--text-primary);
    margin-left: 0.25rem;
  }

  .skill-card.expanded .expand-icon {
    transform: rotate(180deg);
  }

  .skill-card.expanded {
    background: var(--glass-bg-hover);
    border-color: rgba(56, 249, 62, 0.4);
  }

  .skill-description {
    max-height: 0;
    overflow: hidden;
    margin-top: 0;
    padding-top: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
    transition: all 0.3s ease;
    opacity: 0;
  }

  .skill-card.expanded .skill-description {
    max-height: 200px;
    margin-top: 1rem;
    padding-top: 1rem;
    opacity: 1;
    border-top: 1px solid var(--glass-border);
  }
</style>

<script>
  // Skill card click functionality
  document.querySelectorAll('.skill-card').forEach((card) => {
    card.addEventListener('click', (e) => {
      e.stopPropagation();
      const target = card as HTMLElement;
      const isExpanded = target.classList.contains('expanded');

      // Close all other cards
      document.querySelectorAll('.skill-card').forEach(c => {
        c.classList.remove('expanded');
      });

      // Expand this card if it wasn't expanded
      if (!isExpanded) {
        target.classList.add('expanded');
      }
    });
  });

  // Close skill cards when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (!target.closest('.skill-card')) {
      document.querySelectorAll('.skill-card').forEach(c => {
        c.classList.remove('expanded');
      });
    }
  });
</script>
