---
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <p>&copy; {year} Lucas GAM. <span data-i18n="footer.copyright">All Rights Reserved.</span></p>
  </div>
</footer>
<style>
  footer {
    padding: 2rem;
    text-align: center;
    border-top: 1px solid var(--glass-border);
    background: rgba(13, 13, 13, 0.9);
    backdrop-filter: blur(20px);
  }

  footer p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
