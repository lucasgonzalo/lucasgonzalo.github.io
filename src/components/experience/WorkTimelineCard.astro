---
import L10nText from '../L10nText.astro';
import type { L10n } from '../../i18n/types';

interface Props {
  company: string;
  role: L10n;
  period: string;
  description: L10n[];
  isCurrent?: boolean;
}

const { company, role, period, description, isCurrent } = Astro.props;
---

<div class="timeline-item">
  <div class="timeline-content">
    <div class="timeline-header">
      <div class="timeline-period">{period}</div>
      <div class="timeline-company">{company}</div>
      <div class="timeline-role"><L10nText text={role} /></div>
    </div>
    <ul class="timeline-description">
      {description.map((item) => (
        <li><L10nText text={item} /></li>
      ))}
    </ul>
  </div>
</div>

<style>
  .timeline-item {
    position: relative;
    padding-left: 3rem;
    margin-bottom: 3rem;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 0;
    bottom: -3rem;
    width: 2px;
    background: var(--monster-green);
  }

  .timeline-item:last-child::before {
    bottom: 0;
  }

  .timeline-item::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75rem;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--monster-green);
    box-shadow: 0 0 10px var(--monster-glow);
    z-index: 1;
  }

  .timeline-content {
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .timeline-content:hover {
    background: var(--glass-bg-hover);
    border-color: rgba(56, 249, 62, 0.3);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .timeline-header {
    margin-bottom: 1.5rem;
  }

  .timeline-period {
    display: inline-block;
    background: var(--gradient-primary);
    color: var(--bg-deep);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .timeline-company {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--monster-green);
    margin-bottom: 0.5rem;
  }

  .timeline-role {
    font-size: 1.1rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .timeline-description {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline-description li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .timeline-description li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--monster-green);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .timeline-content {
      padding: 1.5rem;
    }

    .timeline-company {
      font-size: 1.3rem;
    }

    .timeline-description li {
      padding-left: 1.25rem;
    }
  }
</style>
