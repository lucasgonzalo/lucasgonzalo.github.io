---
interface Props {
  title: string;
  description: string;
  link: string;
}

const { title, description, link } = Astro.props;
---

<div class="project-card glass fade-in-up">
  <h3>{title}</h3>
  <p>{description}</p>
  <a href={link} class="btn-project">View Project</a>
</div>

<style>
  .project-card {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--monster-green);
  }

  .project-card p {
    margin-bottom: 1.5rem;
  }

  .project-card .btn-project {
    margin-top: auto;
    align-self: flex-start;
    background: var(--gradient-primary);
    color: var(--bg-deep);
    padding: 0.75rem 2rem;
    border: none;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .project-card .btn-project:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px var(--monster-glow-hover);
  }
</style>
