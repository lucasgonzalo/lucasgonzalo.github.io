---
import { workHistory } from '../../data/work-history';
import WorkTimelineCard from './WorkTimelineCard.astro';
---

<section>
  <div class="container">
    <h2 id="experience" data-i18n="experience.title">Work Experience</h2>
    <div class="timeline-container">
      {workHistory.map((work) => (
        <WorkTimelineCard
          company={work.company}
          role={work.role}
          period={work.period}
          description={work.description}
          isCurrent={work.isCurrent}
        />
      ))}
    </div>
  </div>
</section>

<script>
  window.addEventListener('language-changed', () => {
    const t = window.t || ((key) => key);
    const title = document.querySelector('#experience');
    if (title) {
      const key = title.getAttribute('data-i18n');
      if (key) title.textContent = t(key);
    }
  });
</script>

<style>
  #experience {
    margin: 5rem;
  }

  .timeline-container {
    margin-top: 2rem;
  }

  h2 {
    position: relative;
    display: inline-block;
    margin-bottom: 1rem;
  }

  h2::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 0;
    width: 60px;
    height: 3px;
    background: var(--gradient-primary);
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    #experience {
      margin: 5rem 0.5rem;
    }

    .timeline-container {
      margin-top: 1.5rem;
    }
  }
</style>
