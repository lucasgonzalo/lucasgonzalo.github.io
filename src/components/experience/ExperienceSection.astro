---
import { workHistory } from '../../data/work-history';
import WorkTimelineCard from './WorkTimelineCard.astro';
---

<section>
  <div class="container">
    <h2 class="section-title" id="experience" data-i18n="experience.title">Work Experience</h2>
    <div class="timeline-container">
      {workHistory.map((work) => (
        <WorkTimelineCard
          company={work.company}
          role={work.role}
          period={work.period}
          description={work.description}
          isCurrent={work.isCurrent}
        />
      ))}
    </div>
  </div>
</section>

<style>
  #experience {
    margin: 5rem;
  }

  .timeline-container {
    margin-top: 2rem;
  }

  h2 {
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    #experience {
      margin: 5rem 0.5rem;
    }

    .timeline-container {
      margin-top: 1.5rem;
    }
  }
</style>
