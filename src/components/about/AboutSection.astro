<section>
  <div class="container">
    <div class="glass p-4 fade-in-up">
      <h2 id="about" data-i18n="about.title">About Me</h2>
      <div class="about-content">
        <p data-i18n="about.greeting">Hi, I'm Lucas Gonzalo, a passionate Ruby on Rails developer with 4 years of experience building robust and custom web applications. I specialize in creating scalable solutions that drive business growth.</p>
        <p data-i18n="about.expertise">My expertise spans across full-stack development, from business problem analysis walking through building efficient backend systems and designing intuitive user interfaces. I'm committed to writing clean, maintainable code and staying updated with latest technologies.</p>
      </div>
    </div>
  </div>
</section>

<script>
  window.addEventListener('language-changed', () => {
    const t = window.t || ((key) => key);
    
    const title = document.querySelector('#about');
    const paragraphs = document.querySelectorAll('.about-content p');
    
    if (title) {
      const key = title.getAttribute('data-i18n');
      if (key) title.textContent = t(key);
    }
    
    paragraphs.forEach((p, index) => {
      const key = p.getAttribute('data-i18n');
      if (key) p.textContent = t(key);
    });
  });
</script>

<style>

  #about{
    margin: 3rem;
  }

  h2 {
    position: relative;
    display: inline-block;
  }

  h2::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 0;
    width: 60px;
    height: 3px;
    background: var(--gradient-primary);
    border-radius: 2px;
  }

  .p-4 {
    padding: 1.5rem !important;
  }

  @media (max-width: 768px) {
    #about {
      margin: 5rem 0.5rem;
    }
  }
</style>
