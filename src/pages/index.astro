    <!-- Bootstrap 5.3.8 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Google Translate Widget -->
    <script type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'auto',
                includedLanguages: 'en,es,fr,de,pt,ja,ko,zh-CN,ru,it',
                layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
                autoDisplay: false
            }, 'google_translate_element');
        }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    
    <!-- Smooth Scroll Script -->
    <script is:inline>
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add fade-in animation on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.fade-in-up').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(30px)';
            el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(el);
        });

        // Skill card expand/collapse functionality
        document.querySelectorAll('.skill-card').forEach(card => {
            card.addEventListener('click', function(e) {
                e.stopPropagation();
                const isExpanded = this.classList.contains('expanded');
                
                // Close all other cards
                document.querySelectorAll('.skill-card').forEach(c => {
                    c.classList.remove('expanded');
                });
                
                // Expand this card if it wasn't expanded
                if (!isExpanded) {
                    this.classList.add('expanded');
                }
            });
        });

        // Close skill cards when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.skill-card')) {
                document.querySelectorAll('.skill-card').forEach(c => {
                    c.classList.remove('expanded');
                });
            }
        });

        // Google Translate dropdown toggle
        const translateToggle = document.getElementById('translateToggle');
        const translateDropdown = document.getElementById('googleTranslateDropdown');
        const btnCloseTranslate = document.querySelector('.btn-close-translate');

        if (translateToggle && translateDropdown) {
            translateToggle.addEventListener('click', (e) => {
                e.stopPropagation();
                translateDropdown.classList.toggle('hidden');
            });

            btnCloseTranslate.addEventListener('click', (e) => {
                e.stopPropagation();
                translateDropdown.classList.add('hidden');
            });
        }

        // Close translate dropdown when clicking outside
        document.addEventListener('click', (e) => {
            if (translateDropdown && !e.target.closest('#translateToggle') && !e.target.closest('#googleTranslateDropdown')) {
                translateDropdown.classList.add('hidden');
            }
        });
    </script>
</body>

