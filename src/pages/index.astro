---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleBackground from '../components/particles/ParticleBackground.astro';
import Header from '../components/header/Header.astro';
import Hero from '../components/hero/Hero.astro';
import AboutSection from '../components/about/AboutSection.astro';
import SkillsSection from '../components/skills/SkillsSection.astro';
import ExperienceSection from '../components/experience/ExperienceSection.astro';
import ProjectsSection from '../components/projects/ProjectsSection.astro';
import ContactSection from '../components/contact/ContactSection.astro';
import Footer from '../components/footer/Footer.astro';
---

<BaseLayout title="Lucas GAM - Software Developer">
  <ParticleBackground slot="particles" />
  <Header slot="header" />

  <main>
    <Hero />
    <AboutSection />
    <SkillsSection />
    <ExperienceSection />
    <ProjectsSection />
    <ContactSection />
  </main>

  <Footer slot="footer" />
</BaseLayout>

