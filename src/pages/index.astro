---
import '../styles/main.css';
const particleCount = 50;
---

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lucas GAM - Software Developer</title>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Lucas Abregú Maradona - Full-Stack Ruby on Rails Developer with 4 years of experience building robust web applications" />
    <!-- Bootstrap 5.3.8 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <!-- Font Awesome 6.5.0 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon" href="/favicon.ico" type="image/png">
</head>

<body>
    <!-- Particle Background -->
    <div class="particle-container" id="particles">
        {Array.from({ length: particleCount }).map((_, i) => (
            <div class="particle" style={{
                left: `${Math.random() * 100}%`,
                animationDelay: `${Math.random() * 20}s`,
                animationDuration: `${15 + Math.random() * 10}s`,
                width: `${2 + Math.random() * 2}px`,
                height: `${2 + Math.random() * 2}px`
            }}></div>
        ))}
    </div>

    <!-- Header -->
    <header>
        <div class="container">
            <h1>Lucas GAM</h1>
            <nav>
                <ul>
                    <li><a href="#about">About</a></li>
                    <li><a href="#skills">Skills</a></li>
                    <li><a href="#experience">Experience</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <!-- Hero Section -->
        <section class="hero">
            <div class="container">
                <div class="hero-content fade-in-up">
                    <h1 class="mb-2">Lucas Abregú Maradona</h1>
                    <p class="subtitle">Full-Stack Ruby on Rails Developer</p>
                    <div class="hero-buttons">
                        <a href="#contact" class="btn-primary">Get In Touch</a>
                        <a href="#experience" class="btn-outline">View Work</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- About Section -->
        <section id="about">
            <div class="container">
                <div class="glass p-4 fade-in-up">
                    <h2>About Me</h2>
                    <p>Hi, I'm Lucas Gonzalo, a passionate Ruby on Rails developer with 4 years of experience building robust and custom web applications. I specialize in creating scalable solutions that drive business growth.</p>
                    <p>My expertise spans across full-stack development, from designing intuitive user interfaces to building efficient backend systems. I'm committed to writing clean, maintainable code and staying updated with the latest technologies.</p>
                </div>
            </div>
        </section>

        <!-- Skills Section -->
        <section id="skills" class="skills-section">
            <div class="container">
                <h2>Technologies</h2>
                <div class="skills-grid">
                    <div class="skill-card glass">
                        <i class="fab fa-html5"></i>
                        <span>HTML5</span>
                    </div>
                    <div class="skill-card glass">
                        <i class="fab fa-css3-alt"></i>
                        <span>CSS3</span>
                    </div>
                    <div class="skill-card glass">
                        <i class="fab fa-js-square"></i>
                        <span>JavaScript</span>
                    </div>
                    <div class="skill-card glass">
                        <i class="fas fa-gem"></i>
                        <span>Ruby on Rails</span>
                    </div>
                    <div class="skill-card glass">
                        <i class="fas fa-database"></i>
                        <span>PostgreSQL</span>
                    </div>
                    <div class="skill-card glass">
                        <i class="fas fa-database"></i>
                        <span>Redis</span>
                    </div>
                    <div class="skill-card glass">
                        <i class="fab fa-docker"></i>
                        <span>Docker</span>
                    </div>
                    <div class="skill-card glass">
                        <i class="fab fa-git"></i>
                        <span>Git - GitHub - GitLab</span>
                    </div>
                    <div class="skill-card glass">
                        <i class="fab fa-aws"></i>
                        <span>Amazon Web Services</span>
                    </div>
                    <div class="skill-card glass">
                        <i class="fab fa-google"></i>
                        <span>Google Cloud</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Experience Section -->
        <section id="experience">
            <div class="container">
                <h2>Experience</h2>
                <div class="experience-grid">
                    <div class="project-card glass fade-in-up">
                        <h3>Enterprise Web Application</h3>
                        <p>Developed a comprehensive web application for a large enterprise, focusing on fast deployment and scalability. The solution handles thousands of concurrent users with optimal performance.</p>
                        <a href="#" class="btn-project">View Project</a>
                    </div>
                    <div class="project-card glass fade-in-up">
                        <h3>Startup MVP</h3>
                        <p>Built a startup's MVP using Ruby on Rails, enabling the company to launch quickly and gather critical user feedback. Delivered in 6 weeks with a full feature set.</p>
                        <a href="#" class="btn-project">View Project</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section id="contact">
            <div class="container">
                <div class="glass p-4">
                    <h2 class="text-center">Contact</h2>
                    <div class="contact-info">
                        <p>Have a project in mind or want to collaborate? Feel free to reach out!</p>
                        <p>Send me an email at <a href="mailto:lgabregu@gmail.com">lgabregu@gmail.com</a></p>
                        <p>Connect with me on <a href="https://www.linkedin.com/in/lucas-gonzalo-abregu-maradona" target="_blank" rel="noopener noreferrer">LinkedIn</a></p>
                    </div>
                    
                    <form class="contact-form" action="https://formspree.io/f/xovabybo" method="POST">
                        <div class="form-group">
                            <label for="email">Your Email</label>
                            <input type="email" id="email" name="email" class="form-control" placeholder="your@email.com" required />
                        </div>
                        <div class="form-group">
                            <label for="message">Your Message</label>
                            <textarea id="message" name="message" class="form-control" rows="5" placeholder="Drop some words here..." required></textarea>
                        </div>
                        <button type="submit" class="btn-submit">Send Message</button>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2024 Lucas GAM. All Rights Reserved.</p>
        </div>
    </footer>

    <!-- Bootstrap 5.3.8 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Smooth Scroll Script -->
    <script is:inline>
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add fade-in animation on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.fade-in-up').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(30px)';
            el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(el);
        });
    </script>
</body>

</html>
