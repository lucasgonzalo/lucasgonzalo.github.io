---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Lucas Abregú Maradona - Full-Stack Ruby on Rails Developer with 4 years of experience building robust web applications' } = Astro.props;

import '../styles/global.css';
---
<!DOCTYPE html>
<html>

  <!-- Head bootstrap: set <html lang> synchronously, before first paint.
       The heavy translation work runs later from the deferred bundled module
       (see the <script> near the end of <body>); this tiny inline script only
       picks the language so dual-render content and CSS see the right locale. -->
  <script is:inline>
    (function(){try{var l=localStorage.getItem('language');
    if(!l){l=(navigator.language||'').startsWith('es')?'es':'en';}
    document.documentElement.lang=l;}catch(e){document.documentElement.lang='en';}})();
  </script>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XVXEB8RBHP"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-XVXEB8RBHP');
  </script>

  <script defer data-domain="lucasgonzalo.github.io" src="https://analiticas.multisitio.top/js/script.js"></script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />

  <!-- Bootstrap 5.3.8 CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
  <!-- Font Awesome 6.5.0 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <!-- Google Fonts: Inter & Orbitron -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Orbitron:wght@500;700&display=swap" rel="stylesheet">

  <!-- Commented out old favicon -->
  <!-- <link rel="icon" href="/favicon.ico" type="image/png"> -->

  <!-- New animated green diamond favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-MDGVVF5Z');</script>
  <!-- End Google Tag Manager -->
</head>

<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MDGVVF5Z"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <slot name="particles" />
  <slot name="header" />
  <main><slot /></main>
  <footer><slot name="footer" /></footer>

  <!-- i18n runtime: bundled TS module (src/i18n) is the single source of truth.
       Deferred (type=module); gated on DOMContentLoaded so component listeners
       are attached before the init-dispatch of language-changed fires. -->
  <script>
    import { initLanguage } from '../i18n';
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLanguage);
    } else {
      initLanguage();
    }
  </script>

  <!-- Bootstrap 5.3.8 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
